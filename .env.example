# ==================================================
# DeskSharing Configuration Example
# ==================================================
# This file is only a template.
# Copy this file to ".env" and adjust the values for your environment.
#
# Example:
# cp .env.example .env
# ==================================================


# --------------------------------------------------
# Application
# --------------------------------------------------

# External port on the host.
# The application runs inside the container on port 8080.
APP_PORT=8080


# --------------------------------------------------
# PostgreSQL Container
# --------------------------------------------------

# PostgreSQL database name
POSTGRES_DB=desksharing

# PostgreSQL database user
POSTGRES_USER=desksharing_user

# PostgreSQL database password
POSTGRES_PASSWORD=CHANGE_ME


# --------------------------------------------------
# Microsoft Entra Login
# --------------------------------------------------

# Client ID from the Microsoft Entra App Registration
MICROSOFT_CLIENT_ID=CHANGE_ME

# Client Secret from the Microsoft Entra App Registration
MICROSOFT_CLIENT_SECRET=CHANGE_ME

# Tenant ID from Microsoft Entra
MICROSOFT_TENANT_ID=CHANGE_ME